# Copy this file to .env and adjust as needed. .env is never committed
# (see .gitignore) — this is where real secrets belong once the app needs
# them (API keys, a cloud database connection string, etc.).

# SQLite is sufficient locally. In production (deployed, with several
# accounts using it) a real database is required instead — see the README
# deployment section — because most free hosting disks are not persistent:
# a redeploy or restart would wipe radar.db entirely. A Postgres connection
# string can be pasted here as given by the provider ("postgresql://" or
# "postgres://" — normalized automatically).
DATABASE_URL=sqlite:///./radar.db
DEBUG=true

# Signing key for user session tokens (JWT) — see app/auth.py. No changes
# needed locally (a default value is provided). In production this MUST be
# overridden with a unique, random value — generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# (the render.yaml in this repo generates it automatically instead).
SECRET_KEY=

# Free key from Google AI Studio (aistudio.google.com -> Get API key)
GEMINI_API_KEY=
# Free key from Groq (console.groq.com -> API Keys) — optional automatic
# fallback used only if Gemini fails or runs out of quota. Without it, the
# app behaves exactly as before.
GROQ_API_KEY=
